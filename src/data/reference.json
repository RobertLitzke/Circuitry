    {
      "id": "ohms-law",
      "title": "Ohm's law and power",
      "summary": "Voltage, current, resistance and watts, with a live circuit",
      "lesson": "what-flows",
      "blocks": [
        {
          "kind": "figure",
          "figure": "loop",
          "caption": "A battery, a resistor, a lamp and a switch in one loop. Tap a wire to probe it."
        },
        {
          "kind": "table",
          "columns": [
            "To find",
            "From",
            "Formula"
          ],
          "rows": [
            [
              "Voltage",
              "Current and resistance",
              "V = I × R"
            ],
            [
              "Current",
              "Voltage and resistance",
              "I = V ÷ R"
            ],
            [
              "Resistance",
              "Voltage and current",
              "R = V ÷ I"
            ],
            [
              "Power",
              "Voltage and current",
              "P = V × I"
            ],
            [
              "Power",
              "Current and resistance",
              "P = I² × R"
            ],
            [
              "Power",
              "Voltage and resistance",
              "P = V² ÷ R"
            ]
          ]
        },
        {
          "kind": "text",
          "text": "Run it backwards to choose a part, then fit the nearest standard value. 9 V and 20 mA want 450 Ω; the E12 series gives 470 Ω."
        },
        {
          "kind": "table",
          "columns": [
            "Series",
            "Values a decade",
            "Values"
          ],
          "rows": [
            [
              "E12",
              "12",
              "10 12 15 18 22 27 33 39 47 56 68 82"
            ],
            [
              "E24",
              "24",
              "E12 plus 11 13 16 20 24 30 36 43 51 62 75 91"
            ]
          ]
        },
        {
          "kind": "terms",
          "items": [
            {
              "term": "Energy",
              "means": "Watt-hours = volts × amp-hours. 1 Wh = 3600 J."
            },
            {
              "term": "Run time",
              "means": "Hours = watt-hours ÷ watts."
            }
          ]
        }
      ]
    },
    {
      "id": "symbols",
      "title": "Schematic symbols",
      "summary": "The symbol for every part the lessons use",
      "lesson": "what-flows",
      "blocks": []
    },
    {
      "id": "series-parallel",
      "title": "Series, parallel and dividers",
      "summary": "Adding resistances, Kirchhoff's laws, dividers and cells in series and parallel",
      "lesson": "series-parallel",
      "blocks": [
        {
          "kind": "table",
          "columns": [
            "Joined",
            "What they share",
            "Combined resistance"
          ],
          "rows": [
            [
              "In series",
              "One current; the voltage splits",
              "R1 + R2 + …"
            ],
            [
              "In parallel",
              "One voltage; the current splits",
              "1 ÷ (1/R1 + 1/R2 + …), less than the smallest"
            ],
            [
              "Two in parallel",
              "",
              "(R1 × R2) ÷ (R1 + R2)"
            ]
          ]
        },
        {
          "kind": "terms",
          "items": [
            {
              "term": "Current law",
              "means": "The current into a junction equals the current out of it."
            },
            {
              "term": "Voltage law",
              "means": "The rises and drops round any loop add up to zero."
            }
          ]
        },
        {
          "kind": "terms",
          "items": [
            {
              "term": "Divider",
              "means": "Out = in × R2 ÷ (R1 + R2), unloaded."
            },
            {
              "term": "Stiff divider",
              "means": "Let ten times the load's current run down the divider: R2 no more than a tenth of the load."
            },
            {
              "term": "Thévenin",
              "means": "Seen from its output a divider is its unloaded voltage behind R1 ∥ R2."
            },
            {
              "term": "Inside resistance",
              "means": "Open-circuit volts ÷ short-circuit amps, or the sag under a known load ÷ the load's current."
            }
          ]
        },
        {
          "kind": "table",
          "columns": [
            "Cells",
            "Voltage",
            "Current each gives"
          ],
          "rows": [
            [
              "Two in series",
              "Twice one cell's",
              "All of the load's"
            ],
            [
              "Two matched in parallel",
              "One cell's",
              "Half the load's"
            ]
          ]
        },
        {
          "kind": "figure",
          "figure": "junction",
          "caption": "Three resistors in parallel: the battery's current is the sum of theirs."
        }
      ]
    },
    {
      "id": "reading-parts",
      "title": "Reading parts",
      "summary": "Resistor colour bands, standard values, capacitor codes and polarity marks",
      "lesson": "sources",
      "blocks": [
        {
          "kind": "text",
          "text": "Four-band resistors: two digits, then the number of noughts, then the tolerance. Five-band resistors have three digits before the multiplier."
        },
        {
          "kind": "table",
          "columns": [
            "Colour",
            "Digit",
            "Noughts"
          ],
          "rows": [
            [
              "Black",
              "0",
              "none"
            ],
            [
              "Brown",
              "1",
              "0"
            ],
            [
              "Red",
              "2",
              "00"
            ],
            [
              "Orange",
              "3",
              "000"
            ],
            [
              "Yellow",
              "4",
              "0000"
            ],
            [
              "Green",
              "5",
              "00000"
            ],
            [
              "Blue",
              "6",
              "000000"
            ],
            [
              "Violet",
              "7",
              ""
            ],
            [
              "Grey",
              "8",
              ""
            ],
            [
              "White",
              "9",
              ""
            ],
            [
              "Gold",
              "",
              "÷ 10, or ±5%"
            ],
            [
              "Silver",
              "",
              "÷ 100, or ±10%"
            ]
          ]
        },
        {
          "kind": "table",
          "columns": [
            "Bands",
            "Value"
          ],
          "rows": [
            [
              "Brown black red",
              "1 kΩ"
            ],
            [
              "Yellow violet brown",
              "470 Ω"
            ],
            [
              "Red red orange",
              "22 kΩ"
            ],
